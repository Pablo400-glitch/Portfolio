---
import TechCard from "../../components/Tech-card.astro";
import ExperienceCard from "../../components/Experience_card.astro";
import WorkCard from "../../components/Work_card.astro";
import MasterCard from "../../components/master_card.astro";
import "../../style/index.css";

import { useTranslations } from "../../i18n/utils";
import LanguagePicker from "../../components/Language_picker.astro";
const imgBase = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];   // Retornamos directamente un array de objetos con los parámetros
}

const { lang } = Astro.params as { lang: "en" | "es" };

const t = useTranslations(lang);

const data = t();

const chunkArray = (array: any[], size: number) => {
  const result = [];
  for (let i = 0; i < array.length; i += size) {
    result.push(array.slice(i, i + size));
  }
  return result;
};

const techRows = chunkArray(data.technologies.technologies_array, 3); // Divide el array de tecnologías en bloques de 3
---

<!doctype html>
<html class="mt-10 mb-36 overflow-auto" style="scrollbar-width: none; -ms-overflow-style: none;" lang={lang}>
    <style>
    div::-webkit-scrollbar {
      display: none; /* Chrome, Safari, Edge */
    }
  </style>
  <head>
    <meta charset="UTF-8" />
    <title>Portfolio</title>
    <link rel="icon" type=`${imgBase}favion.png` href="favicon.png" />
  </head>
  <body>
    <div class="flex justify-center">
      <LanguagePicker />
    </div>    
    <h1 class="mt-8 text-4xl md:text-6xl flex justify-center font-semibold text-center" set:html={data.full_name} />
    <h2 class="mt-5 text-3xl md:text-5xl flex justify-center font-semibold text-center" set:html={data.career_name} />
    <p class="py-5 md:my-10 mx-2 md:mx-48 lg:mx-96 text-lg md:text-3xl text-center" set:html={data.introduction} /> 
    <div class="mt-8 md:mt-10">
      <h1
        class="text-4xl md:text-6xl flex justify-center font-semibold"
        set:html={data.work_experience.title}
      />
      <div class="mx-4 md:mx-48 lg:mx-96 mb-20">
        {
          data.work_experience.experience.map((experience: any) => (
            <ExperienceCard
              positionName={experience.position_name}
              companyName={experience.company_name}
              companyCountry={experience.company_country}
              dateSpan={experience.date_span}
              description={experience.description}
            />
          ))
        }
      </div>
    </div>

    <div>
      <h1 
        class="text-4xl md:text-6xl flex justify-center mb-5 font-semibold text-center" 
        set:html={data.technologies.title}
      />
      {
        techRows.map(
        (row) => (
          <div class="flex flex-wrap justify-center gap-4 md:gap-8">
            {row.map(
              (tech: any) => (
                <TechCard 
                  icon={tech.icon} 
                />
              )
            )}
          </div>
        )
      )
      }
    </div>

    <img src=`${imgBase}Top_Wave.svg` class="w-full" />

    <div style="background-color: #dd1e1e">
      <h1 
        class="pt-10 text-4xl md:text-6xl flex justify-center font-semibold text-center" 
        set:html={data.my_work.title} 
      ></h1>
    
      <div class="py-10 px-24 grid grid-cols-1 md:grid-cols-2">
        {
          data.my_work.work_array.map((work: any) => (
            <div class="">
              <WorkCard
                link={work.link}
                image={work.image}
                webpageName={work.webpage_name}
                description={work.description}
              />
            </div>
          ))
        }
      </div>
    </div>

    <img src=`${imgBase}Down_Wave.svg` class="w-full" />

    <div class="experience-card mx-4 md:mx-24 lg:mx-36 mb-20 mt-12">
      <h1 class="pt-5 text-4xl md:text-6xl flex justify-center font-semibold text-center"> 
        {data.videogames_master.title}
      </h1>
      <p class="flex justify-center text-xl md:text-2xl lg:text-3xl px-4 pb-2 pt-10 text-center mx-20"> 
        {data.videogames_master.description}
      </p>
      
      <div class="px-12 py-12 grid grid-cols-1">
        {        
          data.videogames_master.entries.map((entry: any) => (
            <div class="py-2 lg:px-10">
              <MasterCard
                title={entry.title}
                subtitle={entry.subtitle}
                subject={entry.subject}
                content={entry.description}
                video_link={entry.video_link}
              />
            </div>
          ))
        }
      </div>
    </div>
  </body>

</html>
