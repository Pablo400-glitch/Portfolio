---
import '../style/experience_card.css';

interface Props {
    positionName: string;
    companyName: string;
    companyCountry: string;
    dateSpan: string;
    description: string;
}

const { positionName, companyName, companyCountry, dateSpan, description } = Astro.props;
---

<div class="experience-card py-5 mt-10 px-4 md:px-10 lg:px-20">
    <p class="flex justify-center text-3xl md:text-4xl lg:text-5xl text-center font-semibold"> {positionName} </p>
    <p class="flex justify-center my-4 text-2xl md:text-3xl lg:text-4xl text-center font-medium"> {companyName} ({companyCountry}) </p>
    <p class="flex justify-center text-xl md:text-2xl lg:text-3xl text-center italic"> {dateSpan} </p>
    <p class="flex justify-center text-lg md:text-xl lg:text-2xl px-6 md:px-14 lg:px-28 pb-2 pt-10 text-center"> {description} </p>
</div>
