---
const { title, subtitle, subject, content } = Astro.props;
---
<div class="border-2 border-white bg-black rounded-lg mx-2 transform lg:rotate-2">
    <div class="py-12 px-20"> 
        <p class="flex justify-center text-3xl md:text-4xl lg:text-5xl text-center font-bold">
            {title}
        </p>
        <p class="flex justify-center text-3xl md:text-4xl lg:text-5xl text-center font-bold mt-8">
            {subtitle}
        </p>
        <p class="flex justify-center my-8 text-2xl md:text-3xl lg:text-4xl text-center font-bold"> 
            {subject} 
        </p>
        <p class="flex justify-center text-xl md:text-2xl lg:text-3xl text-center"> 
            {content}
        </p>
    </div>
</div>

