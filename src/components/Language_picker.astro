---
import { languages } from '../i18n/ui';
const imgBase = import.meta.env.BASE_URL;
---

{Object.entries(languages).map(([lang, label]) => (
    <div class="mx-2">
      <a href={`${import.meta.env.BASE_URL}${lang}`}>
        <img 
          src={`${imgBase}language/${lang.toLowerCase()}.svg`} 
          class="w-20 h-20 align-middle"
          alt={`Icono de ${label}`}
        />
      </a>
    </div>
))}